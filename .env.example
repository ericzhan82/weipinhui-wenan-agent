APP_NAME=vipshop-kidswear-copy-agent-system
APP_ENV=production

POSTGRES_DB=vipshop_copy
POSTGRES_USER=vipshop
POSTGRES_PASSWORD=change_me_strong_password

BACKEND_PORT=8000
FRONTEND_PORT=80
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false

STORAGE_DIR=/app/storage
AUTH_SECRET=change_me_auth_secret
AUTH_TOKEN_TTL_SECONDS=86400
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_DISPLAY_NAME=系统管理员
COPY_BATCH_WORKER_CONCURRENCY=1
COPY_BATCH_WORKER_POLL_SECONDS=2

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=mock
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=0
LLM_TEMPERATURE=0.4
